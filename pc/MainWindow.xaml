<Window x:Class="ConnectPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect — 3D Electronics Simulator  •  v2.1"
        Width="1240" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#10161c" Foreground="#dbeafe"
        AllowDrop="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1f2a36"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="BorderBrush" Value="#3b506b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#dbeafe"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#dbeafe"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ========================= BANNER / TOOLBAR ========================= -->
        <Border DockPanel.Dock="Top" Background="#16212c" BorderBrush="#2b3b4d" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,6">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="CONNECT" FontSize="22" FontWeight="Bold" Foreground="#4fc3f7"/>
                    <TextBlock Text="3D Electronics Simulator — v2.1 (нативная Windows-сборка)" FontSize="9.5" Foreground="#94a3b8"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="DemoBtn" Content="Демо" Click="DemoBtn_Click"/>
                    <Button x:Name="AddBtn" Content="＋ Добавить" Click="AddBtn_Click"/>
                    <Button x:Name="ToolsBtn" Content="🛠 Инструменты" Click="ToolsBtn_Click"/>
                    <Button x:Name="EspPanelBtn" Content="◼ панель ESP" Click="EspPanelBtn_Click"/>
                    <Button x:Name="CodeBtn" Content="⌨ Прошивка" Click="CodeBtn_Click"/>
                    <Button x:Name="ProjectBtn" Content="💾 Проект" Click="ProjectBtn_Click"/>
                    <Button x:Name="StartBtnToolbar" Content="▶ Запуск" Background="#22c55e" Foreground="White" FontWeight="Bold" Click="StartStop_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MusicBtn" Content="🎵 выкл" Click="MusicBtn_Click"/>
                    <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="1" Value="0.35" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    <Button Content="Сброс вида" Click="ResetView_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================= STATUS BAR ========================= -->
        <Border DockPanel.Dock="Bottom" Background="#0b1220" BorderBrush="#2b3b4d" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,4">
                <TextBlock x:Name="ModeStatus" Text="Режим: КАМЕРА" VerticalAlignment="Center"/>
                <TextBlock x:Name="SideStatus" Text="Плата: TOP (верх) • провода: TOP" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="SelectionStatus" Text="Ничего не выбрано" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="PowerStatus" Text="Питание: —" VerticalAlignment="Center" Margin="16,0,0,0" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SideColumn" Width="292"/>
            </Grid.ColumnDefinitions>

            <!-- BOARD -->
            <Border Grid.Column="0" Background="#0f1b24" Margin="6" BorderBrush="#2b3b4d" BorderThickness="1">
                <Grid>
                    <ContentControl x:Name="BoardHost"/>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Background="#00000088" CornerRadius="5" Padding="7,4">
                        <TextBlock x:Name="Hint" FontSize="9.5" Foreground="#cbd5e1" Text="Камера: тащите левой кнопкой • колесо — масштаб"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================= SIDE PANEL (popup-overlay) ========================= -->
            <Border x:Name="SidePanel" Grid.Column="1" Background="#111c26" BorderBrush="#2b3b4d" BorderThickness="1" Margin="0,6,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#16212c" Padding="8,6">
                        <DockPanel>
                            <TextBlock x:Name="SideTitle" Text="ПАНЕЛЬ" FontWeight="Bold" FontSize="13"/>
                            <Button DockPanel.Dock="Right" Content="✕" Width="28" HorizontalAlignment="Right" Click="CloseSide_Click"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SideContent" Margin="8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="ConnectPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect — 3D Electronics Simulator  •  v2.9"
        Width="1240" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#10161c" Foreground="#dbeafe"
        AllowDrop="False">
    <Window.Resources>
        <!-- Кнопки: видимая обводка, скругление, подсветка при наведении/нажатии -->
        <Style TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2a3a4c" Offset="0"/>
                        <GradientStop Color="#1b2836" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="BorderBrush" Value="#52779e"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7dd3fc"/>
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2b4258"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#bae6fd"/>
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3b5a78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#16283a"/>
            <Setter Property="BorderBrush" Value="#2f4d6d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#dbeafe"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#dbeafe"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#dbeafe"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="2,3"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ========================= BANNER / TOOLBAR ========================= -->
        <Border DockPanel.Dock="Top" Background="#16212c" BorderBrush="#2b3b4d" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,6">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="CONNECT" FontSize="22" FontWeight="Bold" Foreground="#4fc3f7"/>
                    <TextBlock Text="3D Electronics Simulator — v2.9 (нативная Windows-сборка)" FontSize="9.5" Foreground="#94a3b8"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="TutorialBtn" Content="🎓 Туториал" Click="TutorialBtn_Click"/>
                    <Button x:Name="DemoBtn" Content="Демо" Click="DemoBtn_Click"/>
                    <Button x:Name="AddBtn" Content="＋ Добавить" Click="AddBtn_Click"/>
                    <Button x:Name="ToolsBtn" Content="🛠 Инструменты" Click="ToolsBtn_Click"/>
                    <Button x:Name="EspPanelBtn" Content="◼ панель ESP" Click="EspPanelBtn_Click"/>
                    <Button x:Name="CodeBtn" Content="⌨ Прошивка" Click="CodeBtn_Click"/>
                    <Button x:Name="ProjectBtn" Content="💾 Проект" Click="ProjectBtn_Click"/>
                    <Button x:Name="StartBtnToolbar" Content="▶ Запуск" Background="#22c55e" Foreground="White" FontWeight="Bold" Click="StartStop_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MusicBtn" Content="🎵 выкл" Click="MusicBtn_Click"/>
                    <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="1" Value="0.35" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    <Button Content="Сброс вида" Click="ResetView_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================= STATUS BAR ========================= -->
        <Border DockPanel.Dock="Bottom" Background="#0b1220" BorderBrush="#2b3b4d" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,5">
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="ModeStatus" Text="Режим: КАМЕРА"/></Border>
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="SideStatus" Text="Плата: TOP (верх) • провода: TOP"/></Border>
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="SelectionStatus" Text="Ничего не выбрано"/></Border>
                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right"><TextBlock x:Name="PowerStatus" Text="Питание: —"/></Border>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SideColumn" Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TOOL RAIL -->
            <Border Grid.Column="0" Background="#0d1622" BorderBrush="#2b3b4d" BorderThickness="1" Margin="6,6,0,6" CornerRadius="8">
                <StackPanel Margin="4,6">
                    <Button x:Name="RailCamera" Tag="Camera" Click="ModeRail_Click" Margin="2,3" Padding="2,6">
                        <StackPanel><TextBlock Text="📷" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Камера" FontSize="8.5" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="RailMoveBoard" Tag="MoveBoard" Click="ModeRail_Click" Margin="2,3" Padding="2,6">
                        <StackPanel><TextBlock Text="✋" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Плата" FontSize="8.5" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="RailMove" Tag="Move" Click="ModeRail_Click" Margin="2,3" Padding="2,6">
                        <StackPanel><TextBlock Text="↔" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Деталь" FontSize="8.5" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="RailWire" Tag="Wire" Click="ModeRail_Click" Margin="2,3" Padding="2,6">
                        <StackPanel><TextBlock Text="✒" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Провод" FontSize="8.5" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="RailSim" Tag="Sim" Click="ModeRail_Click" Margin="2,3" Padding="2,6">
                        <StackPanel><TextBlock Text="🖱" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Симул." FontSize="8.5" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="RailMeasure" Tag="Measure" Click="ModeRail_Click" Margin="2,3" Padding="2,6">
                        <StackPanel><TextBlock Text="📏" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Замер" FontSize="8.5" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="RailDelete" Tag="Delete" Click="ModeRail_Click" Margin="2,3" Padding="2,6">
                        <StackPanel><TextBlock Text="🗑" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Удалить" FontSize="8.5" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- BOARD -->
            <Border Grid.Column="1" Background="#0f1b24" Margin="6" BorderBrush="#2b3b4d" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ContentControl x:Name="BoardHost"/>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Background="#00000088" CornerRadius="5" Padding="7,4">
                        <TextBlock x:Name="Hint" FontSize="9.5" Foreground="#cbd5e1" Text="Камера: тащите левой кнопкой • колесо — масштаб"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================= SIDE PANEL (popup-overlay) ========================= -->
            <Border x:Name="SidePanel" Grid.Column="2" Background="#111c26" BorderBrush="#2b3b4d" BorderThickness="1" Margin="0,6,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#16212c" Padding="8,6">
                        <DockPanel>
                            <TextBlock x:Name="SideTitle" Text="ПАНЕЛЬ" FontWeight="Bold" FontSize="13"/>
                            <Button DockPanel.Dock="Right" Content="✕" Width="28" HorizontalAlignment="Right" Click="CloseSide_Click"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SideContent" Margin="8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
